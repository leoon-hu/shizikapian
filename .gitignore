# 系统 / IDE
.DS_Store
.idea/
.vscode/

# 依赖与构建产物（各子项目各自装、各自 build）
node_modules/
dist/
dev-dist/
*.log

# 本机环境
.env
.env.*

# 音色试听产物（npm run audio -- --audition）
.audition/

# 审片用的候选与拼图（npm run photos -- --candidates / --sheet）
.photos-review/

